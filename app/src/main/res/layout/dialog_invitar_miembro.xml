<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Correo del usuario -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Correo del usuario a invitar"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/txtEmailInvitarDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/surface_container_lowest"
        android:drawableStart="@drawable/ic_mail"
        android:drawablePadding="12dp"
        android:hint="usuario@gestia.com"
        android:inputType="textEmailAddress"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/on_surface"
        android:textSize="14sp" />

    <!-- Rol a asignar -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Rol en el proyecto"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spRolInvitarDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/outline" />

</LinearLayout>
