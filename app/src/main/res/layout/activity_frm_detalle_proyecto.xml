<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".vista.frm_detalle_proyecto">

    <!-- 1. ENCABEZADO FIJO -->
    <RelativeLayout
        android:id="@+id/headerDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnVolverDetalle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:onClick="volverAProyectos"
            android:src="@drawable/arrow_back_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/lblTituloHeaderDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="48dp"
            android:layout_toEndOf="@id/btnVolverDetalle"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Detalle del Proyecto"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Proyecto Alpha" />
    </RelativeLayout>

    <!-- 2. BOTÓN INFERIOR FIJO ("Nueva Tarea") -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevaTarea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary_container"
        android:minHeight="48dp"
        android:onClick="crearNuevaTarea"
        android:text="+ Nueva tarea"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        app:cornerRadius="8dp" />

    <!-- 3. CONTENIDO DESPLAZABLE (NestedScrollView) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnNuevaTarea"
        android:layout_below="@id/headerDetalle"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- HERO CARD (Resumen Principal) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@id/badgeProgress"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblNombreDetalle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text=""
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Nombre del Proyecto" />

                            <TextView
                                android:id="@+id/lblDescripcionDetalle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                tools:text="Descripción del proyecto" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/badgeProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/ic_launcher_background"
                            android:backgroundTint="@color/primary_container"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="8dp"
                            android:text="0%"
                            android:textColor="@color/on_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="60%" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/lblFechasDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        tools:text="Fecha inicio - Fecha fin" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pestañas Horizontales -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabFases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary_container"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="mostrarTabFases"
                        android:text="Fases/Etapas"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabResumen"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="mostrarTabResumen"
                        android:text="Resumen"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTareas"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="abrirTareasProyecto"
                        android:text="Tareas"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabEquipo"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="abrirPantallaEquipo"
                        android:text="Equipo"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Barra de acciones rápidas del proyecto -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportarPdf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="exportarReportePdf"
                        android:text="Exportar PDF"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalendarioProyecto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="abrirCalendarioProyecto"
                        android:text="Calendario"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClonarProyecto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="mostrarDialogoClonarProyecto"
                        android:text="Clonar plantilla"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEliminarProyecto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="confirmarEliminarProyecto"
                        android:text="Eliminar proyecto"
                        android:textAllCaps="false"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/error" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SECCIÓN FASES DEL PROYECTO -->
            <LinearLayout
                android:id="@+id/layoutFasesProyecto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- STEPPER VERTICAL DE FASES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="Progreso de Fases"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarFase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary_container"
                        android:maxLines="1"
                        android:minHeight="40dp"
                        android:onClick="mostrarDialogoAgregarFase"
                        android:text="+ Agregar Fase"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />
                </LinearLayout>

                <!-- RecyclerView Stepper Vertical de Fases -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvFasesStepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_fase_stepper" />

            </LinearLayout>

            <!-- SECCIÓN RESUMEN DEL PROYECTO (OCULTA POR DEFECTO) -->
            <LinearLayout
                android:id="@+id/layoutResumenProyecto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Tarjeta 1: Información General -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/outline_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información del Proyecto"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblResumenTipo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tipo: -"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/lblResumenEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Estado: -"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/lblResumenFechas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fechas: -"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/lblResumenDescripcion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Sin descripción"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta 2: Métricas de Avance -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/outline_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resumen Operativo"
                            android:textColor="@color/primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblResumenFases"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Fases: 0 completadas de 0"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/lblResumenTareasTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Tareas totales: 0"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblResumenTareasDesglose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pendientes: 0  |  En progreso: 0  |  Finalizadas: 0"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/lblResumenEquipo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Miembros del equipo: 0"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>