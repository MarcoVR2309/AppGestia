<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".vista.frm_proyectos">

    <!-- 1. ENCABEZADO FIJO -->
    <RelativeLayout
        android:id="@+id/headerProyectos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:onClick="volverAlHome"
            android:src="@drawable/arrow_back_24dp_e3e3e3_fill0_wght400_grad0_opsz24"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Mis proyectos"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnFiltrar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Filtrar"
            android:src="@drawable/ic_filter"
            app:tint="@color/primary" />
    </RelativeLayout>

    <!-- FLOATING ACTION BUTTON PARA CREAR PROYECTO -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarProyecto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:contentDescription="Nuevo Proyecto"
        android:onClick="mostrarDialogoCrearProyecto"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary_container"
        app:tint="@color/on_primary" />

    <!-- 2. CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerProyectos"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Buscador -->
            <EditText
                android:id="@+id/txtBuscarProyecto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/surface_container_lowest"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="12dp"
                android:hint="Buscar proyectos..."
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <!-- Filtros Horizontales (Chips) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChipTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/primary_container"
                        android:text="Todos"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChipActivos"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Activos"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChipAcademicos"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Académicos"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChipEmpresariales"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:text="Empresariales"
                        android:textAllCaps="false"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        app:cornerRadius="18dp"
                        app:strokeColor="@color/outline_variant" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- LISTA DE PROYECTOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Lista de Proyectos"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- RecyclerView Dinámico de Proyectos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvProyectos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_proyecto" />

            <TextView
                android:id="@+id/tvSinProyectos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="No se encontraron proyectos con este filtro"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</RelativeLayout>